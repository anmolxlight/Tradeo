# Tradeo - Environment Configuration
# Copy this file to .env.local and fill in your values

# ─────────────────────────────
# AI API Configuration (OpenAI-compatible)
# ─────────────────────────────
# Uses OpenCode Go API by default (DeepSeek V4 Flash)
# Set your OpenCode Go API key or any OpenAI-compatible API key
OPENCODE_API_KEY=sk-your_api_key_here
AI_API_KEY=${OPENCODE_API_KEY}

# Optional: Override the API base URL and model
# Default: https://api.opencode.ai/v1 with opencode-go/deepseek-v4-flash
# AI_API_BASE_URL=https://api.opencode.ai/v1
# AI_MODEL=opencode-go/deepseek-v4-flash

# ─────────────────────────────
# Supabase Database Configuration
# ─────────────────────────────
# Get these from your Supabase project dashboard (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─────────────────────────────
# Clerk Authentication Configuration
# ─────────────────────────────
# Get these from your Clerk dashboard (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# ─────────────────────────────
# App Configuration
# ─────────────────────────────
# For local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# For production, set this to your deployed URL:
# NEXT_PUBLIC_APP_URL=https://tradeo.vercel.app
